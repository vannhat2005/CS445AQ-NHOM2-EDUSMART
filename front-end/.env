
# ==========================================
# EDUSMART FRONTEND
# ==========================================

# Backend Spring Boot
VITE_API_URL=http://localhost:8080

# ==========================================
# COURSE REGISTRATION
# ==========================================

# POST /api/student/courses/{courseId}/register
VITE_COURSE_REGISTER_PATH=/api/student/courses/:courseId/register

# ==========================================
# MOMO PAYMENT
# ==========================================

# GET /api/student/checkout/{registrationId}/momo/status
VITE_MOMO_STATUS_PATH=/api/student/checkout/:registrationId/momo/status

# ==========================================
# ZALOPAY PAYMENT
# ==========================================

# GET /api/student/checkout/{registrationId}/payment-status
VITE_ZALOPAY_STATUS_PATH=/api/student/checkout/:registrationId/payment-status
